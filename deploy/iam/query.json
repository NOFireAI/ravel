{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueryList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/", "t/*/*/c/*", "t/*/catalog/*/*", "admission/query/*", "sys/query/workers/*", "t/*/pq/t/*"]
        }
      }
    },
    {
      "Sid": "QueryListBootstrapKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringEquals": {
          "s3:prefix": ["sys/tenancy", "sys/qualification", "sys/gc", "sys/auth"]
        }
      }
    },
    {
      "Sid": "QueryListTenantBootstrapKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/????????????????????????????????/config", "t/????????????????????????????????/enc", "t/????????????????????????????????/m/meta", "t/????????????????????????????????/m/prov", "t/????????????????????????????????/l/prov", "t/????????????????????????????????/s/prov", "t/????????????????????????????????/p/prov", "t/????????????????????????????????/a/prov", "t/????????????????????????????????/u/prov", "t/????????????????????????????????/a/state/latest", "t/????????????????????????????????/pq/grants"]
        }
      }
    },
    {
      "Sid": "QueryRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l1/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/admission/query/*",
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/sys/query/workers/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/config",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/alert-lease",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/state/latest",
        "arn:aws:s3:::my-ravel-bucket/t/*/m/meta",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/grants",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/t/*"
      ]
    },
    {
      "Sid": "QueryWrite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/snap/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/HEAD",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/idx/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*",
        "arn:aws:s3:::my-ravel-bucket/admission/query/*",
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/query/workers/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/alert-lease",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/state/latest",
        "arn:aws:s3:::my-ravel-bucket/sys/pq-probe/*"
      ]
    },
    {
      "Sid": "QueryManifestCreate",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/pq/t/*/v/????????????????????.pqm",
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "QueryProbeDelete",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/sys/pq-probe/*"
    },
    {
      "Sid": "QueryTenantKms",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:GenerateDataKey*", "kms:Decrypt"],
      "Resource": ["arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-TENANT-KEY-ID"]
    },
    {
      "Sid": "DenyDeleteProtected",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*/0000/*",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/sys/t/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/grants"
      ]
    }
  ]
}
