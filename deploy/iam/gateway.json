{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GatewayList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/", "t/*/*/l0/*", "t/*/*/c/*", "t/*/*/admission/*", "t/*/catalog/*/*"]
        }
      }
    },
    {
      "Sid": "GatewayListBootstrapKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringEquals": {
          "s3:prefix": ["sys/tenancy", "sys/qualification", "sys/gc", "sys/auth"]
        }
      }
    },
    {
      "Sid": "GatewayListTenantBootstrapKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/????????????????????????????????/config", "t/????????????????????????????????/enc", "t/????????????????????????????????/m/meta", "t/????????????????????????????????/m/prov", "t/????????????????????????????????/l/prov", "t/????????????????????????????????/s/prov", "t/????????????????????????????????/l/idem/????????????????????????????????.????????T??.idm", "t/????????????????????????????????/s/idem/????????????????????????????????.????????T??.idm"]
        }
      }
    },
    {
      "Sid": "GatewayRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/idem/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/admission/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/*",
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/t/*/config",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/m/meta"
      ]
    },
    {
      "Sid": "GatewayWrite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/idem/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/admission/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/snap/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/HEAD",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/idx/*",
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/t/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/m/meta"
      ]
    },
    {
      "Sid": "GatewayProvCreate",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/m/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/l/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/s/prov"
      ],
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "GatewayEncCreate",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/enc",
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "GatewayEncCas",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/enc",
      "Condition": {
        "Null": {
          "s3:if-match": "false"
        }
      }
    },
    {
      "Sid": "GatewayAdmissionDelete",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/?/admission/*"
    },
    {
      "Sid": "GatewayTenantKms",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:GenerateDataKey*", "kms:Decrypt"],
      "Resource": ["arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-TENANT-KEY-ID"]
    },
    {
      "Sid": "DenyDeleteProtected",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*/0000/*",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/sys/t/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/grants"
      ]
    }
  ]
}
