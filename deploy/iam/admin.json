{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AdminList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/*", "sys/*"]
        }
      }
    },
    {
      "Sid": "AdminRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*",
        "arn:aws:s3:::my-ravel-bucket/sys/*"
      ]
    },
    {
      "Sid": "AdminWrite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/qualify/*",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/del/*.dreq",
        "arn:aws:s3:::my-ravel-bucket/t/*/config",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/grants",
        "arn:aws:s3:::my-ravel-bucket/sys/pq-probe/*"
      ]
    },
    {
      "Sid": "AdminProvCreate",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/m/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/l/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/s/prov"
      ],
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "AdminProvCas",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/m/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/l/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/s/prov"
      ],
      "Condition": {
        "Null": {
          "s3:if-match": "false"
        }
      }
    },
    {
      "Sid": "AdminQualifyDelete",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/sys/qualify/*"
    },
    {
      "Sid": "AdminProbeDelete",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/sys/pq-probe/*"
    },
    {
      "Sid": "AdminTenantKms",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": ["arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-TENANT-KEY-ID"]
    },
    {
      "Sid": "DenyDeleteProtected",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*/0000/*",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/sys/t/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/grants"
      ]
    }
  ]
}
