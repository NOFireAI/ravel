{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MaintainList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/", "t/*/*/l0/*", "t/*/*/c/*", "t/*/*/l1/*", "t/*/*/idem/*", "t/*/*/del/*", "t/*/*/maint/*", "t/*/catalog/*/snap/*", "t/*/catalog/*/idx/*", "sys/maintain/workers/*", "sys/maintain/memo/*", "sys/query/workers/*", "quarantine/t/*/*/l0/*", "t/*/a/", "quarantine/t/*/a/", "t/*/pq/t/*"]
        }
      }
    },
    {
      "Sid": "MaintainListBootstrapKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringEquals": {
          "s3:prefix": ["sys/tenancy", "sys/qualification", "sys/gc"]
        }
      }
    },
    {
      "Sid": "MaintainListTenantBootstrapKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-ravel-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["t/????????????????????????????????/config", "t/????????????????????????????????/enc", "t/????????????????????????????????/m/prov", "t/????????????????????????????????/l/prov", "t/????????????????????????????????/s/prov", "t/????????????????????????????????/catalog/m/HEAD", "t/????????????????????????????????/catalog/l/HEAD", "t/????????????????????????????????/catalog/s/HEAD", "t/????????????????????????????????/a/state/latest"]
        }
      }
    },
    {
      "Sid": "MaintainRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l1/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/maint/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/del/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/HEAD",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/snap/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/idx/*",
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/sys/maintain/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/config",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/a/state/latest"
      ]
    },
    {
      "Sid": "MaintainWrite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l1/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/maint/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/del/*.done",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/maintain/*",
        "arn:aws:s3:::my-ravel-bucket/quarantine/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/snap/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/idx/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/HEAD"
      ]
    },
    {
      "Sid": "MaintainProvCreate",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/m/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/l/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/s/prov"
      ],
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "MaintainProvCas",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/m/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/l/prov",
        "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/s/prov"
      ],
      "Condition": {
        "Null": {
          "s3:if-match": "false"
        }
      }
    },
    {
      "Sid": "MaintainEncCreate",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/enc",
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "MaintainEncCas",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-ravel-bucket/t/????????????????????????????????/enc",
      "Condition": {
        "Null": {
          "s3:if-match": "false"
        }
      }
    },
    {
      "Sid": "MaintainDelete",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/c/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/l1/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/idem/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/maint/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*/0001/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/del/*.dreq",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/snap/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/idx/*",
        "arn:aws:s3:::my-ravel-bucket/sys/maintain/workers/*",
        "arn:aws:s3:::my-ravel-bucket/sys/query/workers/*",
        "arn:aws:s3:::my-ravel-bucket/quarantine/t/*/*/l0/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/t/*"
      ]
    },
    {
      "Sid": "MaintainTenantKms",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:GenerateDataKey*", "kms:Decrypt"],
      "Resource": ["arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-TENANT-KEY-ID"]
    },
    {
      "Sid": "DenyDeleteProtected",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::my-ravel-bucket/sys/tenancy",
        "arn:aws:s3:::my-ravel-bucket/sys/qualification",
        "arn:aws:s3:::my-ravel-bucket/sys/gc",
        "arn:aws:s3:::my-ravel-bucket/t/*/*/prov",
        "arn:aws:s3:::my-ravel-bucket/t/*/catalog/*/HEAD",
        "arn:aws:s3:::my-ravel-bucket/t/*/u/*/0000/*",
        "arn:aws:s3:::my-ravel-bucket/sys/auth",
        "arn:aws:s3:::my-ravel-bucket/sys/t/*",
        "arn:aws:s3:::my-ravel-bucket/t/*/enc",
        "arn:aws:s3:::my-ravel-bucket/t/*/pq/grants"
      ]
    }
  ]
}
