/target
/bench/
**/*.rs.bk
*.profraw
.DS_Store
/minio-data
/examples/otlp_metrics_fixture.pb
__pycache__/
/.superpowers/
/.cache/
node_modules/

# Per-developer Claude Code config and its helper scripts. .claude/settings.json
# is the team's; anything machine-specific belongs in these instead.
.claude/settings.local.json
.claude/helpers/

# graft's local graph cache - regenerable, not committed (run `graft build`).
graft/

# Local, per-checkout state for .claude/guards/epic-status-nudge.mjs.
.claude/.epic-status-nudge-state.json

# The disk watchdog drops this in the scope directory when it fires; the
# harness commit-on-death sweeps an unignored file into a wip commit.
.disk-watchdog-fired
# Fleet executors write gate logs and any cargo-install tree inside the
# checkout, because $HOME on the amd64 executor class is a 1 GB tmpfs and
# /tmp is the harness capture filesystem. Ignored for the same reason as
# the watchdog marker above: commit-on-death must not sweep them in.
.gate-logs/
.dd-tools/
