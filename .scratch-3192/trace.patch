diff --git a/crates/ravel-cache/src/trace.rs b/crates/ravel-cache/src/trace.rs
new file mode 100644
index 000000000..f7871550d
--- /dev/null
+++ b/crates/ravel-cache/src/trace.rs
@@ -0,0 +1,86 @@
+//! Diagnostic access trace (#3192), gated on `RAVEL_CACHE_TRACE=<file>`.
+//! One tab-separated line per event: seq, cache, op, key, intent, outcome,
+//! extra.
+
+use std::fs::File;
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use crate::AccessIntent;
+use crate::key::CacheKey;
+
+static SINK: OnceLock<Option<Mutex<(u64, File)>>> = OnceLock::new();
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+fn sink() -> Option<&'static Mutex<(u64, File)>> {
+    SINK.get_or_init(|| {
+        let path = std::env::var_os("RAVEL_CACHE_TRACE")?;
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .ok()?;
+        Some(Mutex::new((0, file)))
+    })
+    .as_ref()
+}
+
+pub fn enabled() -> bool {
+    sink().is_some()
+}
+
+pub fn next_id() -> u64 {
+    NEXT_ID.fetch_add(1, Ordering::Relaxed)
+}
+
+pub fn key_str(key: &CacheKey) -> String {
+    let mut s = String::with_capacity(40);
+    for b in &key.content_hash[..8] {
+        s.push_str(&format!("{b:02x}"));
+    }
+    format!("{s}:{}:{}", key.offset, key.len)
+}
+
+pub fn intent_str(intent: AccessIntent) -> &'static str {
+    match intent {
+        AccessIntent::Interactive => "interactive",
+        AccessIntent::BulkScan => "bulk",
+        AccessIntent::Maintenance => "maintenance",
+    }
+}
+
+pub fn emit(cache: &str, op: &str, key: &str, intent: &str, outcome: &str, extra: &str) {
+    let Some(sink) = sink() else {
+        return;
+    };
+    if let Ok(mut guard) = sink.lock() {
+        guard.0 += 1;
+        let line = format!(
+            "{}\t{cache}\t{op}\t{key}\t{intent}\t{outcome}\t{extra}\n",
+            guard.0
+        );
+        let _ = guard.1.write_all(line.as_bytes());
+    }
+}
+
+pub fn emit_key(
+    cache: u64,
+    op: &str,
+    key: &CacheKey,
+    intent: Option<AccessIntent>,
+    outcome: &str,
+    extra: &str,
+) {
+    if !enabled() {
+        return;
+    }
+    emit(
+        &format!("C{cache}"),
+        op,
+        &key_str(key),
+        intent.map_or("-", intent_str),
+        outcome,
+        extra,
+    );
+}
